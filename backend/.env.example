PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/ferroadmin
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXPIRA=8h
NODE_ENV=development
# Crear este bucket en Supabase Storage y habilitar lectura pública.
# La clave de servicio solo se configura en el backend; no usarla en el frontend.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<clave-de-servicio>
SUPABASE_STORAGE_BUCKET=productos

# Correo (T21): en desarrollo se usa una cuenta de pruebas de https://ethereal.email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
