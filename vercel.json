{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix backend && npm ci --include=dev --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/tareas/stock-bajo", "schedule": "0 13 * * *" },
    { "path": "/api/tareas/stock-bajo", "schedule": "0 21 * * *" }
  ]
}
